# Base de données Postgres (Neon, Supabase ou Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/eco-driver?sslmode=require"

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe : compte DU CHAUFFEUR (AchMedia ne touche pas aux fonds)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Mapbox (autocomplétion, itinéraire, carte)
MAPBOX_TOKEN="pk.eyJ..."
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ..."

# Emails ET SMS (Brevo). Une seule clé pour les deux canaux.
# Le domaine d'envoi doit être validé dans Brevo.
BREVO_API_KEY="xkeysib-..."
EMAIL_FROM="Eco Driver <reservations@eco-driver.fr>"
DRIVER_NOTIFICATION_EMAIL="chauffeur@example.com"

# Coordonnées de secours du chauffeur, utilisées tant que sa fiche en base
# n'est pas remplie (voir npm run seed-driver).
DRIVER_PHONE_E164="+33600000000"

# Espace chauffeur
AUTH_SECRET="une-longue-chaine-aleatoire-de-32-caracteres-minimum"
# Identifiants de secours, utilisés tant qu'aucune fiche chauffeur n'existe
# en base. Créer la fiche avec :
#   npm run seed-driver -- "email@exemple.fr" "motdepasse" "Prénom"
DRIVER_EMAIL="chauffeur@example.com"
DRIVER_PASSWORD_HASH_B64=""

# Tâche planifiée Vercel (purge des réservations PENDING_PAYMENT > 24 h).
# Vercel génère cette valeur automatiquement lors du premier déploiement avec
# un cron ; en local, une chaîne aléatoire suffit pour tester la route.
CRON_SECRET=""
